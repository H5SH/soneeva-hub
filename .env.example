ENVIRONMENT=development
LOG_LEVEL=INFO

# Public URL of this service — the gateway redirects merchants back here.
SERVICE_BASE_URL=http://localhost:8080

# Callers authenticate with per-application Ed25519 keypairs, not a shared secret.
# The public half lives in Firestore at applications/{id}; issue one with:
#     uv run python scripts/keygen.py <application_id>

STRIPE_SECRET_KEY=sk_test_xxx
# Fallback only. Prefer applications/{id}.stripe_webhook_secret so each app can use its own
# Stripe account.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Firestore. Omit on GCP — the runtime service account is picked up automatically.
GOOGLE_APPLICATION_CREDENTIALS=./paymentServiceAccount.json
