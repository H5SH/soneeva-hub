#!/usr/bin/env bash
# Lint, file length and tests before a push. Enable with: git config core.hooksPath scripts/hooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "[pre-push] ruff check ..."
uv run ruff check .

echo "[pre-push] file length ..."
uv run python scripts/check_lines.py

echo "[pre-push] tests ..."
uv run pytest -q

echo "[pre-push] passed"
