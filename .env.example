# ─── Required ────────────────────────────────────────────────────────────────
# Live mode (`{appId}`); needs write on Products, Prices, Meters and Meter Events.
STRIPE_SECRET_KEY=sk_live_xxx
# This hub's public URL: voices get it as HUB_URL, webhook:create registers it with Stripe.
SERVICE_BASE_URL=http://localhost:8080

# ─── Required for staging ────────────────────────────────────────────────────
# Stripe test mode, used for every `{appId}_staging` caller and every test business. Empty: staging off (503).
STRIPE_TEST_SECRET_KEY=sk_test_xxx
# Test mode's fallback webhook secret; prefer `cli webhook:create {appId}_staging`. Local: `stripe listen`.
STRIPE_TEST_WEBHOOK_SECRET=

# ─── Optional ────────────────────────────────────────────────────────────────
# production (default) or development: /docs on, local console for handoffs, reload.
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8080
# Fallback webhook secret; prefer per-app ones (`cli webhook:create`). Local: from `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# Master Twilio account: subaccounts and numbers. Empty: no number buying.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# /recover and `/` (reads admin's session cookie): admin's AUTH_SECRET value; Firebase web API key for /recover sign-in.
# Either empty: the page says "not configured".
AUTH_SECRET=
FIREBASE_API_KEY=
# Local: admin service account (never commit it). Omit on Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=../firebaseServiceAccount.json
