ENVIRONMENT=development
LOG_LEVEL=INFO

# Public URL of this service — the gateway redirects merchants back here.
SERVICE_BASE_URL=http://localhost:8080


# ─── Stripe ──────────────────────────────────────────────────────────────────
# Needs write on Products and Prices: the dashboard creates them when you add a paid plan.
# A restricted key is reported on the plan form rather than failing halfway through.
STRIPE_SECRET_KEY=sk_test_xxx

# Fallback only. Prefer applications/{id}.stripe_webhook_secret so each app can use its own
# Stripe account.
STRIPE_WEBHOOK_SECRET=whsec_xxx


# ─── Firestore ───────────────────────────────────────────────────────────────
# Omit on GCP — the runtime service account is picked up automatically. The project id comes
# from inside this file, so there is no separate variable for it.
GOOGLE_APPLICATION_CREDENTIALS=./paymentServiceAccount.json


# ─── Admin dashboard ─────────────────────────────────────────────────────────
# Signs the session. Shared with every application that accepts the same session, which is
# what lets a Next.js app verify it without a Firebase admin SDK.
#     openssl rand -base64 32
SESSION_SECRET=

# Optional.
SESSION_TTL_DAYS=5
SESSION_COOKIE_NAME=codinative_session

# Set to a parent domain to share the session across subdomains, e.g. .example.com. Blank
# keeps the cookie on this host. Cookies cannot cross unrelated domains at all — there the
# token has to be handed over explicitly rather than inherited.
SESSION_COOKIE_DOMAIN=

# Firebase web config, from Project settings > Your apps > Web app. Public by design: these
# ship to the browser in any client that uses them. Only Auth is used there, which needs the
# key and the domain and nothing else.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=


# Callers authenticate with per-application Ed25519 keypairs, not a shared secret. The public
# half lives in Firestore at applications/{id}; issue one from the dashboard, which prints
# the private half and the env block to paste into the calling app.
