ENVIRONMENT=development
LOG_LEVEL=INFO

# Public URL of this service — the gateway redirects merchants back here.
SERVICE_BASE_URL=http://localhost:8080

# Shared HMAC secret. The Next apps sign their x-api-key JWT with this.
API_SECRET=change-me

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Firestore. Omit on GCP — the runtime service account is picked up automatically.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
